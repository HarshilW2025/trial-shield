{
  "manifest_version": 3,
  "name": "Trial Shield (concept)",
  "version": "0.1.0",
  "description": "Concept for the Westpac Innovation and Coding Competition 2026. Reads subscription fine print at checkout and fills a Protected card with a one-time CVV.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["terms.js", "content.js"],
    "all_frames": true,
    "match_about_blank": true,
    "run_at": "document_idle"
  }],
  "action": { "default_popup": "popup.html", "default_title": "Trial Shield",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
